    string q;
};

# Represents the Queries record for the operation: getEpisodeRecommendations
public type GetEpisodeRecommendationsQueries record {
    # Whether or not to exclude podcasts with explicit language. 1 is yes, and 0 is no
    @http:Query {name: "safe_mode"}
    0|1 safeMode = 0;
};

