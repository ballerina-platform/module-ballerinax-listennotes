    @jsondata:Name {value: "page_number"}
    int pageNumber?;
    PodcastSimple[] podcasts?;
    @jsondata:Name {value: "has_previous"}
    boolean hasPrevious?;
    @jsondata:Name {value: "next_page_number"}
    int nextPageNumber?;
    @jsondata:Name {value: "has_next"}
    boolean hasNext?;
    @jsondata:Name {value: "previous_page_number"}
    int previousPageNumber?;
};

# The url of this episode on [ListenNotes.com](https://www.ListenNotes.com)
public type EpisodeLNUrlField string;

# The url of this podcast on [ListenNotes.com](https://www.ListenNotes.com)
public type PodcastLNUrlField string;

public type EpisodeMinimum record {
    # Image url for this podcast's artwork. If you are using PRO/ENTERPRISE plan, then it's
    # a high resolution image (1400x1400). If you are using FREE plan, then it's the same as **thumbnail**,
    # low resolution image (300x300)
    ImageField image?;
    # Thumbnail image url for this podcast's artwork (300x300)
    ThumbnailField thumbnail?;
    @jsondata:Name {value: "explicit_content"}
    ExplicitField explicitContent?;
    @jsondata:Name {value: "listennotes_edit_url"}
    EpisodeLNEditUrlField listennotesEditUrl?;
    @jsondata:Name {value: "audio_length_sec"}
    AudioLengthSecField audioLengthSec?;
    # Web link of this episode
    LinkField link?;
    # Html of this episode's full description
    EpisodeDescriptionField description?;
    # Episode name
    EpisodeNameField title?;
    @jsondata:Name {value: "listennotes_url"}
    EpisodeLNUrlField listennotesUrl?;
    # Audio url of this episode, which can be played directly
    AudioField audio?;
    # Episode id, which can be used to further fetch detailed episode metadata via `GET /episodes/{id}`
    EpisodeIdField id?;
    @jsondata:Name {value: "pub_date_ms"}
    EpisodePubDateMsField pubDateMs?;
    @jsondata:Name {value: "maybe_audio_invalid"}
    MaybeAudioInvalidField maybeAudioInvalid?;
};

public type Genre record {
    # Parent genre id
    @jsondata:Name {value: "parent_id"}
    int parentId?;
    # Genre name
    string name?;
    # Genre id
    int id?;
};

# Published date of this curated list. It is an Epoch Unix timestamp in milliseconds
public type CuratedPubDateMsField int;

# An item in a playlist
public type PlaylistItem record {
    # Timestamp when this item is added. It is an Epoch Unix timestamp in milliseconds
    @jsondata:Name {value: "added_at_ms"}
    int addedAtMs?;
    # Notes for this item
    string notes?;
    PlaylistEpisodeData|PlaylistPodcastData|PlaylistCustomAudioData|PlaylistDeletedItemData data?;
    # Playlist item id
    int id?;
    # The type of this playlist item.
    # If a playlist is **episode_list**, then an item could be either **episode** or **custom_audio**.
    # If it's **podcast_list**, then an item can only be **podcast**
    "episode"|"custom_audio"|"podcast" 'type?;
};

# Plain text of podcast name
public type PodcastTitleOriginalField string;

# Low resolution image url of the playlist
public type PlaylistThumbnailField string;

# Episode name
public type EpisodeNameField string;

public type EpisodeSimple record {
    # Image url for this episode.
    # If an episode doesn't have its own image, then this field would be the url of the podcast artwork image.
    # If you are using PRO/ENTERPRISE plan, then it's
    # a high resolution image (1400x1400). If you are using FREE plan, then it's the same as **thumbnail**,
    # low resolution image (300x300)
    EpisodeImageField image?;
    # Thumbnail image (300x300) url for this episode.
    # If an episode doesn't have its own image, then this field would be the url of the podcast artwork thumbnail image
    EpisodeThumbnailField thumbnail?;
    @jsondata:Name {value: "explicit_content"}
    ExplicitField explicitContent?;
    @jsondata:Name {value: "listennotes_edit_url"}
    EpisodeLNEditUrlField listennotesEditUrl?;
    @jsondata:Name {value: "audio_length_sec"}
    AudioLengthSecField audioLengthSec?;
    # Web link of this episode
    LinkField link?;
    # Html of this episode's full description
    EpisodeDescriptionField description?;
    # Episode name
    EpisodeNameField title?;
    @jsondata:Name {value: "listennotes_url"}
    EpisodeLNUrlField listennotesUrl?;
    PodcastMinimum podcast?;
    # Audio url of this episode, which can be played directly
    AudioField audio?;
    # Episode id, which can be used to further fetch detailed episode metadata via `GET /episodes/{id}`
    EpisodeIdField id?;
    @jsondata:Name {value: "pub_date_ms"}
    EpisodePubDateMsField pubDateMs?;
    @jsondata:Name {value: "maybe_audio_invalid"}
    MaybeAudioInvalidField maybeAudioInvalid?;
};

# The id of the most recently published episode of this podcast, which can be used to further fetch detailed episode metadata via `GET /episodes/{id}`
public type LatestEpisodeIdField string;

# Represents the Queries record for the operation: getBestPodcasts
public type GetBestPodcastsQueries record {
    # Filter best podcasts by the publisher's country/region.
    # This is to narrow down the results to include "best podcasts" produced in a specific country/region.
    # You can get the supported country codes (e.g., us, jp, gb...) from `GET /regions`.
    # If not specified, you'll get "best podcasts" produced in any country/region.
    # If you want to get a country/region's "best podcasts" that are also produced in that country/region,
    # then you need to specify both **region** and **publisher_region**,
    # e.g., `region=jp` and `publisher_region=jp`
    @http:Query {name: "publisher_region"}
    string publisherRegion?;
    # Whether or not to exclude podcasts with explicit language. 1 is yes, and 0 is no
    @http:Query {name: "safe_mode"}
    0|1 safeMode = 0;
    # Filter best podcasts by language.
    # You can get a list of supported languages (e.g., English, Chinese, Japanese...) from `GET /languages`.
    # If not specified, you'll get "best podcasts" in any language
    string language?;
    # Page number of those podcasts in this genre
    int page?;
    # How do you want to sort these podcasts?
    # If you'd like to sort by popularity, please use **listen_score**
    "recent_added_first"|"oldest_added_first"|"recent_published_first"|"oldest_published_first"|"listen_score" sort = "recent_added_first";
    # Filter best podcasts by country/region.
    # Please note that podcasts that are "best" in a country/region may not be produced in that country/region.
    # For example, a podcast from the US may be very popular in Canada.
    # You can get the supported country codes (e.g., us, jp, gb...) from `GET /regions`.
    # If not specified, you'll get "best podcasts" in United States
    string region = "us";
    # You can get the id from `GET /genres`. If not specified, it'll be the overall best podcasts, which can be considered as a special genre
    @http:Query {name: "genre_id"}
    string genreId?;
};

# Represents the Queries record for the operation: getPlaylists
public type GetPlaylistsQueries record {
    # How do you want to sort playlists?
    "recent_added_first"|"oldest_added_first"|"name_a_to_z"|"name_z_to_a" sort = "recent_added_first";
    # Page number of playlists
    int page = 1;
};

# Image url for this episode.
# If an episode doesn't have its own image, then this field would be the url of the podcast artwork image.
# If you are using PRO/ENTERPRISE plan, then it's
# a high resolution image (1400x1400). If you are using FREE plan, then it's the same as **thumbnail**,
# low resolution image (300x300)
public type EpisodeImageField string;

