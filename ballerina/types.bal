# When **type** is *episode*
public type EpisodeSearchResult record {
    # Image url for this episode.
    # If an episode doesn't have its own image, then this field would be the url of the podcast artwork image.
    # If you are using PRO/ENTERPRISE plan, then it's
    # a high resolution image (1400x1400). If you are using FREE plan, then it's the same as **thumbnail**,
    # low resolution image (300x300)
    EpisodeImageField image?;
    # Thumbnail image (300x300) url for this episode.
    # If an episode doesn't have its own image, then this field would be the url of the podcast artwork thumbnail image
    EpisodeThumbnailField thumbnail?;
    # Plain text of this episode's description
    @jsondata:Name {value: "description_original"}
    string descriptionOriginal?;
    @jsondata:Name {value: "itunes_id"}
    ITunesIdField itunesId?;
    @jsondata:Name {value: "explicit_content"}
    ExplicitField explicitContent?;
    @jsondata:Name {value: "audio_length_sec"}
    AudioLengthSecField audioLengthSec?;
    # Web link of this episode
    LinkField link?;
    @jsondata:Name {value: "listennotes_url"}
    EpisodeLNUrlField listennotesUrl?;
    # Highlighted segment of this episode's title
    @jsondata:Name {value: "title_highlighted"}
    string titleHighlighted?;
    # Plain text of this episode' title
    @jsondata:Name {value: "title_original"}
    string titleOriginal?;
    # RSS url of this podcast. This field is available only in the PRO/ENTERPRISE plan
    RssField rss?;
    # Highlighted segment of this episode's description
    @jsondata:Name {value: "description_highlighted"}
    string descriptionHighlighted?;
    # The podcast that this episode belongs to
    EpisodeSearchResultPodcast podcast?;
    # Audio url of this episode, which can be played directly
    AudioField audio?;
    # Episode id, which can be used to further fetch detailed episode metadata via `GET /episodes/{id}`
    EpisodeIdField id?;
    @jsondata:Name {value: "pub_date_ms"}
    EpisodePubDateMsField pubDateMs?;
    # Up to 2 highlighted segments of the audio transcript of this episode
    @jsondata:Name {value: "transcripts_highlighted"}
    string[] transcriptsHighlighted?;
};

public type SearchResponseResults EpisodeSearchResult|PodcastSearchResult|CuratedListSearchResult;

public type GetPodcastsInBatchResponse record {
    PodcastSimple[] podcasts;
    # Up to 10 latest episodes from these podcasts, sorted by **pub_date**. This field shows up only when **show_latest_episodes** is 1
    @jsondata:Name {value: "latest_episodes"}
    EpisodeSimple[] latestEpisodes?;
};

public type GetRegionsResponse record {
    record {} regions;
};

public type GetEpisodesInBatchForm record {
    # Comma-separated list of episode ids
    string ids;
};

# A deleted item in a playlist. It always carries its status
public type PlaylistDeletedItemData record {
    *DeletedItem;
    # The status of this episode or podcast. For now, the only possible value is **deleted**
    string status;
};

# Curated list name
public type CuratedNameField string;

# The language of this podcast. You can get all supported languages from `GET /languages`
public type LanguageField string;

# Represents the Queries record for the operation: getPlaylistById
public type GetPlaylistByIdQueries record {
    # For playlist items pagination.
    # It's the value of **last_timestamp_ms** from the response of last request.
    # If it's 0 or not specified, just return the latest or the oldest 20 items,
    # depending on the value of the **sort** parameter.
    # It is an Epoch Unix timestamp in milliseconds
    @http:Query {name: "last_timestamp_ms"}
    int lastTimestampMs = 0;
    # How do you want to sort playlist items?
    "recent_added_first"|"oldest_added_first"|"recent_published_first"|"oldest_published_first" sort = "recent_added_first";
    # Select **episode_list** or **podcast_list** to fetch that view.
    # If omitted, use the playlist's saved default type. This query parameter does not change the saved default
    "episode_list"|"podcast_list" 'type?;
};

# Represents the Queries record for the operation: searchEpisodeTitles
public type SearchEpisodeTitlesQueries record {
    # An episode's title, e.g., Jerusalem Demsas on The Dispossessed. You can use double quotes to do verbatim match, e.g., "Jerusalem Demsas on The Dispossessed". Otherwise, it's fuzzy search
    string q;
    # The type of podcast id. Valid values are **listennotes_id**, **itunes_id**, **spotify_id**, and **rss**.
    # Note: **itunes_id** is for Apple Podcasts
    @http:Query {name: "podcast_id_type"}
    "listennotes_id"|"itunes_id"|"spotify_id"|"rss" podcastIdType = "listennotes_id";
    # Refine search results by specifying a podcast through its unique ID.
    # The format of the podcast ID is governed by the podcast_id_type parameter. 
    # For listennotes_id, the podcast ID will look like 'cda18f20f1be4ac7b3cce7d0eb168fff'. 
    # For itunes_id, it will be a numerical value like '983795625'. 
    # For spotify_id, expect a format like '0Z1234tGXD2hVhjFrrhJ7g'. 
    # For rss, the podcast ID will be the RSS URL, e.g., 'https://cowenconvos.libsyn.com/rss'
    @http:Query {name: "podcast_id"}
    string podcastId?;
};

# A playlist
public type PlaylistSummary record {
    # Total audio length of all episodes in this playlist, in seconds
    @jsondata:Name {value: "total_audio_length_sec"}
    int totalAudioLengthSec?;
    # High resolution image url of the playlist
    PlaylistImageField image?;
    # Low resolution image url of the playlist
    PlaylistThumbnailField thumbnail?;
    # The number of episodes (including custom audio) in this playlist
    @jsondata:Name {value: "episode_count"}
    int episodeCount?;
    # Visibility of this playlist
    PlaylistVisibilityField visibility?;
    # The number of podcasts in this playlist
    @jsondata:Name {value: "podcast_count"}
    int podcastCount?;
    # Playlist name
    PlaylistNameField name?;
    # Playlist description
    PlaylistDescriptionField description?;
    # A 11-character playlist id, which can be used to further fetch detailed playlist metadata via `GET /playlists/{id}`
    PlaylistIdField id?;
    # The saved default view of the playlist. Changing it preserves all episodes and podcasts
    PlaylistDefaultTypeField 'type?;
    @jsondata:Name {value: "listennotes_url"}
    PlaylistListennotesUrlField listennotesUrl?;
};

public type SpellCheckResponse record {
    # The corrected text for the entire search term (multiple words/tokens), where misspelled tokens are replaced with the correct texts and html tags <b><i>
    @jsondata:Name {value: "corrected_text_html"}
    string correctedTextHtml;
    # The word in the text query string that is not spelled correctly
    SpellCheckResponseTokens[] tokens;
};

# An episode in a playlist. It always carries its podcast
public type PlaylistEpisodeData record {
    *EpisodeSimple;
    PodcastMinimum podcast;
};

public type PodcastTypeaheadResult record {
    @jsondata:Name {value: "title_highlighted"}
    PodcastTitleHighlightedField titleHighlighted?;
    @jsondata:Name {value: "title_original"}
    PodcastTitleOriginalField titleOriginal?;
    # Image url for this podcast's artwork. If you are using PRO/ENTERPRISE plan, then it's
    # a high resolution image (1400x1400). If you are using FREE plan, then it's the same as **thumbnail**,
    # low resolution image (300x300)
    ImageField image?;
    # Thumbnail image url for this podcast's artwork (300x300)
    ThumbnailField thumbnail?;
    @jsondata:Name {value: "explicit_content"}
    ExplicitField explicitContent?;
    @jsondata:Name {value: "publisher_original"}
    PublisherOriginalField publisherOriginal?;
    @jsondata:Name {value: "publisher_highlighted"}
    PublisherHighlightedField publisherHighlighted?;
    # Podcast id, which can be used to further fetch detailed podcast metadata via `GET /podcasts/{id}`
    PodcastIdField id?;
};

# Represents the Queries record for the operation: getPodcastRecommendations
public type GetPodcastRecommendationsQueries record {
    # Whether or not to exclude podcasts with explicit language. 1 is yes, and 0 is no
    @http:Query {name: "safe_mode"}
    0|1 safeMode = 0;
};

