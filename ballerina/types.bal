    # To include the transcript of this episode or not? If it is 1, then include the transcript in the **transcript** field. The default value is 0 - we don't include transcript by default, because 1) it would make the response data very big, thus slow response time; 2) less than 1% of episodes have transcripts. The transcript field is available only in the PRO/ENTERPRISE plan
    @http:Query {name: "show_transcript"}
    int showTranscript = 0;
};

# Represents the Queries record for the operation: getCuratedPodcasts
public type GetCuratedPodcastsQueries record {
    # Page number of curated lists
    int page = 1;
};

# Passed to the **next_episode_pub_date** parameter of `GET /podcasts/{id}` to paginate through episodes of that podcast. It is an Epoch Unix timestamp in milliseconds
public type NextEpisodePubDateField int;

# Podcast name
public type PodcastNameField string;

# Passed to the **last_timestamp_ms** parameter of `GET /playlists/{id}` to paginate through items of that playlist.
# It is an Epoch Unix timestamp in milliseconds
public type PlaylistLastTimestampMsField int;

# Represents the Queries record for the operation: search
public type SearchQueries record {
    # Whether or not to keep only one episode per podcast in search results. 1 is yes and 0 is no. It works only when **type** is *episode*
    @http:Query {name: "unique_podcasts"}
    0|1 uniquePodcasts = 0;
    # Minimum number of episodes. Applicable only when type parameter is **podcast**
    @http:Query {name: "episode_count_min"}
    int episodeCountMin?;
    # A comma-delimited string of podcast ids (up to 5 podcasts) - you can get a podcast id from the **podcast_id** field in response. This parameter is to exclude search results of a few specific podcasts. It works only when **type** is *episode*
    string ncid?;
    # Offset for search results, for pagination. You'll use **next_offset** from response for this parameter
    int offset = 0;
    # Only show episodes/podcasts/curated lists published before this Epoch Unix timestamp (in milliseconds). 
    # If **published_before** & **published_after** are used at the same time, **published_before** should be bigger than **published_after**
    @http:Query {name: "published_before"}
    int publishedBefore?;
    # Whether or not to exclude podcasts/episodes with explicit language. 1 is yes and 0 is no. It works only when **type** is *episode* or *podcast*
    @http:Query {name: "safe_mode"}
    0|1 safeMode = 0;
    # Limit search results to a specific language. If not specified, it'll be any language. You can get a list of supported languages from `GET /languages`. It works only when **type** is *episode* or *podcast*
    string language?;
    # Whether or not to keep only podcasts that have sponsors in search results. 1 is yes and 0 is no. It works only when **type** is *podcast*.
    # This parameter is available only in the PRO/ENTERPRISE plan
    @http:Query {name: "sponsored_only"}
    0|1 sponsoredOnly = 0;
    # Minimum update frequency in hours (how frequently does a podcast release a new episode). For example, if you want to find "weekly" podcasts, then you can set **update_freq_min**=144 hours (or 6 days) and **update_freq_max**=192 hours (or 8 days). Applicable only when type parameter is **podcast**
    @http:Query {name: "update_freq_min"}
    int updateFreqMin?;
    # A comma-delimited string to search only in specific fields. Allowed values are title, description, author, and audio. If not specified, then search every fields
    @http:Query {name: "only_in"}
    string onlyIn = "title,description,author,audio";
    # What type of contents do you want to search for? 
    "episode"|"podcast"|"curated" 'type = "episode";
    # Maximum number of episodes. Applicable only when type parameter is **podcast**
    @http:Query {name: "episode_count_max"}
    int episodeCountMax?;
    # A comma-delimited string of a list of genre ids. If not specified, then all genres are included. You can find the id and the name of all genres from `GET /genres`. It works only when **type** is *episode* or *podcast*
    @http:Query {name: "genre_ids"}
    string genreIds?;
    # Maximum audio length in minutes. Applicable only when **type** parameter is **episode** or **podcast**.
    # If **type** parameter is **episode**, it's for audio length of an episode.
    # If **type** parameter is **podcast**, it's for average audio length of all episodes in a podcast
    @http:Query {name: "len_max"}
    int lenMax?;
    # Search term, e.g., person, place, topic... You can use double quotes to do verbatim match, e.g., "game of thrones". Otherwise, it's fuzzy search
    string q;
    # Whether or not to keep only podcasts that have guest interviews in search results. 1 is yes and 0 is no. It works only when **type** is *podcast*. 
    # This parameter is available only in the PRO/ENTERPRISE plan
    @http:Query {name: "interviews_only"}
    0|1 interviewsOnly = 0;
    # Sort by date or not? If 0, then sort by relevance. If 1, then sort by date
    @http:Query {name: "sort_by_date"}
    0|1 sortByDate = 0;
    # Maximum update frequency in hours (how frequently does a podcast release a new episode). For example, if you want to find "weekly" podcasts, then you can set **update_freq_min**=144 hours (or 6 days) and **update_freq_max**=192 hours (or 8 days). Applicable only when type parameter is **podcast**
    @http:Query {name: "update_freq_max"}
    int updateFreqMax?;
    # Only show episodes/podcasts/curated lists published after this Epoch Unix timestamp (in milliseconds). 
    # If **published_before** & **published_after** are used at the same time, **published_before** should be bigger than **published_after**
    @http:Query {name: "published_after"}
    int publishedAfter = 0;
    # Limit search results to a specific region (e.g., us, gb, in...). If not specified, it'll be any region. You can get the supported country codes from `GET /regions`. It works only when **type** is *episode* or *podcast*
    string region?;
    # A comma-delimited string of podcast ids (up to 5 podcasts) - you can get a podcast id from the **podcast_id** field in response. This parameter is to limit search results from only a few specific podcasts. It works only when **type** is *episode*
    string ocid?;
    # Minimum audio length in minutes. Applicable only when **type** parameter is **episode** or **podcast**.
    # If **type** parameter is **episode**, it's for audio length of an episode.
    # If **type** parameter is **podcast**, it's for average audio length of all episodes in a podcast
    @http:Query {name: "len_min"}
    int lenMin = 0;
    # The maximum number of search results per page. A valid value should be an integer between 1 and 10 (inclusive)
    @http:Query {name: "page_size"}
    int pageSize = 10;
};

public type RelatedSearchesResponse record {
    # Related search terms
    string[] terms;
};

public type CuratedListSimple record {
    # The total number of podcasts in this curated list
    CuratedTotalPodcastsField total?;
    # Minimum meta data of up to 5 podcasts in this curated list
    PodcastMinimum[] podcasts?;
    @jsondata:Name {value: "source_domain"}
    CuratedSourceDomainField sourceDomain?;
    # This curated list's description
    CuratedDescriptionField description?;
    # Curated list id, which can be used to further fetch detailed curated list metadata via `GET /curated_podcasts/{id}`
    CuratedIdField id?;
    # Curated list name
    CuratedNameField title?;
    @jsondata:Name {value: "pub_date_ms"}
    CuratedPubDateMsField pubDateMs?;
    @jsondata:Name {value: "source_url"}
    CuratedSourceUrlField sourceUrl?;
    @jsondata:Name {value: "listennotes_url"}
    CuratedLNUrlField listennotesUrl?;
};

# Whether or not this episode's audio is invalid. Podcasters may delete the original audio
public type MaybeAudioInvalidField boolean;

public type DeletePodcastResponse record {
    # The status of this podcast deletion request
    "deleted"|"in review" status;
};

# Whether this podcast has sponsors
public type HasSponsorsField boolean;

# The published date of the latest episode of this podcast. It is an Epoch Unix timestamp in milliseconds
public type LatestPubDateMsField int;

# A podcast in a playlist. It always carries its publisher
public type PlaylistPodcastData record {
    *PodcastSimple;
    # Podcast publisher name
    PublisherField publisher;
};

public type CreatePlaylistRequest record {|
    # Who can view the playlist. Creation defaults to public
    "public"|"unlisted"|"private" visibility?;
    # Nonblank playlist name. Leading/trailing whitespace is trimmed; rss is reserved (case insensitive)
    @constraint:String {maxLength: 4096, minLength: 1}
    string name;
    # Playlist description. An empty string clears it
    @constraint:String {maxLength: 4096}
    string description?;
    # The saved default view. Changing it preserves all episodes and podcasts in the playlist
    "episode_list"|"podcast_list" 'type = "episode_list";
|};

public type GetPodcastRecommendationsResponse record {
    PodcastSimple[] recommendations;
};

public type BestPodcastsResponse record {
    int total;
    @jsondata:Name {value: "page_number"}
    int pageNumber;
    PodcastSimple[] podcasts;
    @jsondata:Name {value: "has_previous"}
    boolean hasPrevious;
    # The id of parent genre
    @jsondata:Name {value: "parent_id"}
    int parentId;
    @jsondata:Name {value: "next_page_number"}
    int nextPageNumber;
    # This genre's name
    string name;
    @jsondata:Name {value: "has_next"}
    boolean hasNext;
    # The id of this genre
    int id;
    @jsondata:Name {value: "listennotes_url"}
    BestPodcastsLNUrlField listennotesUrl;
    @jsondata:Name {value: "previous_page_number"}
    int previousPageNumber;
};

# A custom audio item in a playlist. It always carries its audio URL
public type PlaylistCustomAudioData record {
    *CustomAudio;
    # Audio url, which can be played directly
    string audio;
};

public type GetEpisodesInBatchResponse record {
    EpisodeSimple[] episodes;
};

public type GenreIdsField int[];

